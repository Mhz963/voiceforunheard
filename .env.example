# ---------------------------------------------------------------------------
# Public site (VITE_* values are built into the browser bundle — never put
# secrets in a VITE_ variable)
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://voiceforunheard.vercel.app
VITE_CONTACT_EMAIL=binteanayat@gmail.com

# ---------------------------------------------------------------------------
# Contact / consultation delivery (server only — never prefix with VITE_).
# Messages are forwarded to the educator by WhatsApp and email; the phone
# number is never sent to visitors' browsers.
# ---------------------------------------------------------------------------
WHATSAPP_TO=
CALLMEBOT_APIKEY=
CONTACT_TO_EMAIL=
RESEND_API_KEY=
# RESEND_FROM=VoiceForUnheard <onboarding@resend.dev>

# Parent / educator portals. Keep OFF in production: they store data in the
# visitor's browser and cannot check sign-in securely until a backend exists.
VITE_PORTAL_ENABLED=false

# ---------------------------------------------------------------------------
# Payments — OFF until bookings are stored server-side.
# PAYMENTS_ENABLED is enforced by the API; VITE_PAYMENTS_ENABLED only hides UI.
# ---------------------------------------------------------------------------
PAYMENTS_ENABLED=false
VITE_PAYMENTS_ENABLED=false
# Refunds require this secret in an "Authorization: Bearer <token>" header.
# Leave empty to allow refunds only from the Stripe dashboard. Min 24 chars.
REFUND_ADMIN_TOKEN=

# Stripe (USD payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JazzCash hosted Payment Gateway (optional — needs Merchant ID / Password / Integrity Salt)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox
# JAZZCASH_RETURN_URL=https://yourdomain.com/api/payments/jazzcash/return

# JazzCash manual PKR — screenshot upload + super admin approval
JAZZCASH_MANUAL_ENABLED=false
JAZZCASH_MERCHANT_ACCOUNT=

# Optional session prices (defaults: PKR 5000, USD 50)
SESSION_PRICE_PKR=5000
SESSION_PRICE_USD=50
VITE_SESSION_PRICE_PKR=5000
VITE_SESSION_PRICE_USD=50
