# Stripe (USD payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JazzCash hosted Payment Gateway (optional — needs Merchant ID / Password / Integrity Salt)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox
# JAZZCASH_RETURN_URL=https://yourdomain.com/api/payments/jazzcash/return

# JazzCash manual PKR — email-based payment confirmation; super admin approves
JAZZCASH_MANUAL_ENABLED=true
PAYMENT_CONTACT_EMAIL=binteanayat@gmail.com

# Optional session prices (defaults: PKR 5000, USD 50)
SESSION_PRICE_PKR=5000
SESSION_PRICE_USD=50
VITE_SESSION_PRICE_PKR=5000
VITE_SESSION_PRICE_USD=50
